{
  "name": "kimi",
  "displayName": "Kimi",
  "loginUrl": "https://kimi.moonshot.cn/",
  "loginTimeoutMs": 60000,
  "delayBetweenSamplesMs": 25000,
  "delayJitterMs": 15000,
  "actionTimeoutMs": 20000,
  "inputTimeoutMs": 30000,
  "answerStartTimeoutMs": 120000,
  "newChat": {
    "actions": [
      { "type": "goto", "url": "https://kimi.moonshot.cn/", "waitUntil": "domcontentloaded" },
      {
        "type": "clickAny",
        "optional": true,
        "selectors": [
          "text=/\u65b0\u5efa|\u65b0\u4f1a\u8bdd|\u65b0\u5bf9\u8bdd|New chat|New conversation/i",
          "button[aria-label*='\u65b0']",
          "[role='button'][aria-label*='\u65b0']",
          "a[aria-label*='\u65b0']"
        ]
      }
    ]
  },
  "inputSelector": [
    "textarea",
    "div[contenteditable='true']",
    "[role='textbox']"
  ],
  "minAnswerChars": 120,
  "sendButtonSelector": [
    "button[type='submit']",
    "button[aria-label*='\u53d1\u9001']",
    "[role='button'][aria-label*='\u53d1\u9001']",
    "button[title*='\u53d1\u9001']",
    "text=/^\u53d1\u9001$/"
  ],
  "sendButtonTimeoutMs": 3000,
  "sendKeyFallback": "Enter",
  "sendConfirmation": {
    "maxAttempts": 3,
    "timeoutMs": 10000,
    "pollMs": 250,
    "log": true
  },
  "recoverableErrorSelectors": [
    "text=/\u7533\u8bf7\u7e41\u5fd9|\u7cfb\u7edf\u7e41\u5fd9|\u8bf7\u6c42\u7e41\u5fd9|\u64cd\u4f5c\u9891\u7e41|\u8bf7\u7a0d\u540e\u518d\u8bd5|\u7f51\u7edc\u5f02\u5e38|\u751f\u6210\u5931\u8d25|\u521a\u521a\u548cKimi\u804a\u7684\u4eba\u592a\u591a|Kimi\u6709\u70b9\u7d2f|\u9ad8\u5cf0\u671f\u7b97\u529b\u4e0d\u8db3|\u8bf7\u8010\u5fc3\u7b49\u5f85|\u665a\u70b9\u518d\u95ee|rate limit|too many requests|try again/i"
  ],
  "clickRecoverableRetryNearError": true,
  "recoverableErrorActions": {
    "actions": [
      {
        "type": "clickAny",
        "optional": true,
        "label": "refresh or retry",
        "timeoutMs": 5000,
        "selectors": [
          "button:has-text('\u5237\u65b0')",
          "button:has-text('\u91cd\u8bd5')",
          "button:has-text('\u91cd\u65b0\u751f\u6210')",
          "button:has-text('\u518d\u8bd5\u4e00\u6b21')",
          "[role='button']:has-text('\u5237\u65b0')",
          "[role='button']:has-text('\u91cd\u8bd5')",
          "[role='button']:has-text('\u91cd\u65b0\u751f\u6210')",
          "[role='button']:has-text('\u518d\u8bd5\u4e00\u6b21')",
          "button[aria-label*='\u5237\u65b0']",
          "button[aria-label*='\u91cd\u8bd5']",
          "button[title*='\u5237\u65b0']",
          "button[title*='\u91cd\u8bd5']",
          "[aria-label*='\u5237\u65b0']",
          "[aria-label*='\u91cd\u8bd5']",
          "[title*='\u5237\u65b0']",
          "[title*='\u91cd\u8bd5']",
          "[class*='retry']",
          "[class*='refresh']",
          "[class*='reload']",
          "[class*='regenerate']",
          "button:has-text('Retry')",
          "button:has-text('Refresh')",
          "[role='button']:has-text('Retry')",
          "[role='button']:has-text('Refresh')"
        ]
      }
    ]
  },
  "recoverableErrorWaitMs": 8000,
  "recoverableRetryCooldownMs": 45000,
  "assistantMessageSelector": [
    "[data-role='assistant'] [class*='markdown']",
    "[data-message-author-role='assistant']",
    "[class*='assistant'] [class*='markdown']",
    "[class*='message'] [class*='markdown']",
    "[data-role='assistant']",
    "[class*='assistant']",
    "[class*='markdown']",
    ".markdown"
  ],
  "streamingDone": {
    "timeoutMs": 300000,
    "stableMs": 15000,
    "minWaitAfterStartMs": 30000,
    "maxStopButtonWaitAfterValidMs": 60000,
    "allowTextStableWithActionButtons": true,
    "answerActionSelectors": [
      "button[aria-label*='Copy' i]",
      "button[aria-label*='\u590d\u5236']",
      "button[title*='Copy' i]",
      "button[title*='\u590d\u5236']",
      "button[aria-label*='Like' i]",
      "button[aria-label*='Dislike' i]",
      "button[aria-label*='\u70b9\u8d5e']",
      "button[aria-label*='\u70b9\u8e29']",
      "button[aria-label*='Regenerate' i]",
      "button[aria-label*='\u91cd\u65b0\u751f\u6210']",
      "button[aria-label*='Retry' i]",
      "button[aria-label*='\u91cd\u8bd5']",
      "button[aria-label*='Share' i]",
      "button[aria-label*='\u5206\u4eab']",
      "[role='button'][aria-label*='Copy' i]",
      "[role='button'][aria-label*='\u590d\u5236']"
    ],
    "progressLogMs": 15000,
    "pollMs": 1000,
    "stopButtonSelectors": [
      "button[aria-label*='\u505c\u6b62']",
      "button[aria-label*='\u6682\u505c']",
      "text=/\u505c\u6b62|\u6682\u505c|Stop/i"
    ]
  },
  "stateSelectors": {
    "serviceIssueSelectors": [
      "text=/\u7cfb\u7edf\u9519\u8bef|\u7cfb\u7edf\u5f02\u5e38|\u7cfb\u7edf\u7e41\u5fd9|\u7533\u8bf7\u7e41\u5fd9|\u8bf7\u6c42\u7e41\u5fd9|\u521a\u521a\u548cKimi\u804a\u7684\u4eba\u592a\u591a|Kimi\u6709\u70b9\u7d2f|\u9ad8\u5cf0\u671f\u7b97\u529b\u4e0d\u8db3|\u751f\u6210\u5931\u8d25|\u51fa\u9519\u4e86|\u53d1\u751f\u9519\u8bef|\u8bf7\u7a0d\u540e\u518d\u8bd5|\u8bf7\u91cd\u8bd5|server error|system error|something went wrong|request failed/i"
    ]
  },
  "captchaOrRiskSelectors": [
    "iframe[src*='captcha']",
    "input[name='cf-turnstile-response']",
    "text=/captcha|\u9a8c\u8bc1\u7801|\u5b89\u5168\u9a8c\u8bc1|\u4eba\u673a\u9a8c\u8bc1/i"
  ],
  "ignoreLoginExpiredWhenInputReady": true,
  "loginExpiredSelectors": [
    "input[type='password']",
    "input[autocomplete='one-time-code']",
    "input[placeholder*='\u624b\u673a\u53f7']",
    "input[placeholder*='\u624b\u673a\u53f7\u7801']",
    "text=/\u8bf7\u5148\u767b\u5f55\u540e\u7ee7\u7eed\u4f7f\u7528|\u767b\u5f55\u72b6\u6001\u5df2\u5931\u6548|session expired/i"
  ]
}
