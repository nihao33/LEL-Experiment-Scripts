{
  "name": "qwen",
  "displayName": "Qwen",
  "loginUrl": "https://www.qianwen.com/chat",
  "fallbackLoginUrls": [
    "https://www.qianwen.com/"
  ],
  "viewport": { "width": 1920, "height": 950 },
  "windowSize": { "width": 1920, "height": 1030 },
  "useWindowViewport": true,
  "startMaximized": true,
  "loginTimeoutMs": 60000,
  "delayBetweenSamplesMs": 25000,
  "delayJitterMs": 15000,
  "actionTimeoutMs": 20000,
  "inputTimeoutMs": 30000,
  "answerStartTimeoutMs": 120000,
  "newChat": {
    "actions": [
      {
        "type": "goto",
        "url": "https://www.qianwen.com/chat",
        "fallbackUrls": ["https://www.qianwen.com/"],
        "waitUntil": "domcontentloaded"
      },
      {
        "type": "clickAny",
        "optional": true,
        "selectors": [
          "text=/New chat|New Chat|\u65b0\u5efa|\u65b0\u4f1a\u8bdd|\u65b0\u5bf9\u8bdd/i",
          "button[aria-label*='New' i]",
          "[role='button'][aria-label*='New' i]",
          "button[aria-label*='\u65b0']",
          "[role='button'][aria-label*='\u65b0']"
        ]
      }
    ]
  },
  "inputSelector": [
    "textarea",
    "div[contenteditable='true']",
    "[role='textbox']"
  ],
  "sendButtonSelector": [
    "button.send-button",
    ".send-button",
    "button:has(.icon-send)",
    "button:has(use[href*='arrow-up'])",
    "button:has(use[xlink\\:href*='arrow-up'])",
    "button[type='submit']",
    "button[aria-label*='Send' i]",
    "[role='button'][aria-label*='Send' i]",
    "button[title*='Send' i]",
    "button[aria-label*='\u53d1\u9001']",
    "[role='button'][aria-label*='\u53d1\u9001']",
    "text=/^Send$|^\u53d1\u9001$/i"
  ],
  "sendButtonTimeoutMs": 3000,
  "sendTimeoutMs": 30000,
  "sendKeyFallback": "Enter",
  "sendConfirmation": {
    "maxAttempts": 3,
    "timeoutMs": 10000,
    "pollMs": 250,
    "log": true
  },
  "minAnswerChars": 120,
  "assistantMessageSelector": [
    "[data-message-author-role='assistant']",
    "[data-role='assistant']",
    ".response-content",
    ".answer-content",
    "[class*='response-content']",
    "[class*='answer-content']",
    "[class*='model-response']",
    "[class*='assistant-message']",
    "[class*='assistant']",
    "[class*='markdown']",
    ".markdown"
  ],
  "streamingDone": {
    "timeoutMs": 360000,
    "stableMs": 12000,
    "minWaitAfterStartMs": 25000,
    "maxStopButtonWaitAfterValidMs": 45000,
    "allowTextStableWithActionButtons": true,
    "answerActionSelectors": [
      "button[aria-label*='Copy' i]",
      "button[aria-label*='\u590d\u5236']",
      "button[title*='Copy' i]",
      "button[title*='\u590d\u5236']",
      "button[aria-label*='Like' i]",
      "button[aria-label*='Dislike' i]",
      "button[aria-label*='\u70b9\u8d5e']",
      "button[aria-label*='\u70b9\u8e29']",
      "button[aria-label*='Regenerate' i]",
      "button[aria-label*='\u91cd\u65b0\u751f\u6210']",
      "button[aria-label*='Share' i]",
      "button[aria-label*='\u5206\u4eab']",
      "[role='button'][aria-label*='Copy' i]",
      "[role='button'][aria-label*='\u590d\u5236']"
    ],
    "progressLogMs": 15000,
    "pollMs": 1000,
    "stopButtonSelectors": [
      ".send-button:has(.icon-stop)",
      "button:has(.icon-stop)",
      "button:has(use[href*='stop'])",
      "button:has(use[xlink\\:href*='stop'])",
      "[class*='stop-button']",
      "button[aria-label*='Stop' i]",
      "button[aria-label*='\u505c\u6b62']",
      "button[aria-label*='\u6682\u505c']",
      "text=/Stop|\u505c\u6b62|\u6682\u505c/i"
    ]
  },
  "stateSelectors": {
    "serviceIssueSelectors": [
      "text=/\u7cfb\u7edf\u9519\u8bef|\u7cfb\u7edf\u5f02\u5e38|\u7cfb\u7edf\u7e41\u5fd9|\u670d\u52a1\u5f02\u5e38|\u670d\u52a1\u7e41\u5fd9|\u8bf7\u6c42\u5f02\u5e38|\u8bf7\u6c42\u7e41\u5fd9|\u751f\u6210\u5931\u8d25|\u51fa\u9519\u4e86|\u53d1\u751f\u9519\u8bef|\u8bf7\u7a0d\u540e\u518d\u8bd5|\u8bf7\u91cd\u8bd5|server error|system error|something went wrong|request failed/i"
    ]
  },
  "captchaOrRiskSelectors": [
    "iframe[src*='captcha']",
    "input[name='cf-turnstile-response']",
    "text=/captcha|\u9a8c\u8bc1\u7801|\u5b89\u5168\u9a8c\u8bc1|\u4eba\u673a\u9a8c\u8bc1/i"
  ],
  "loginExpiredSelectors": [
    "button:has-text('Log in')",
    "button:has-text('\u767b\u5f55')",
    "text=/please log in|\u8bf7\u767b\u5f55|session expired/i"
  ]
}
